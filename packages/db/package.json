{
  "name": "@pis/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "tsc -p tsconfig.json && drizzle-kit generate",
    "db:push": "tsc -p tsconfig.json && drizzle-kit push",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed:base": "tsx src/seed-base.ts",
    "dev": "echo \"@pis/db: no dev server\""
  },
  "dependencies": {
    "@pis/domain": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.4",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
