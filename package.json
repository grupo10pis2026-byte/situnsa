{
  "name": "pis-titulacion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d && pnpm --filter @pis/api --filter @pis/web --parallel dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run build --filter=@pis/api... && vitest run --config=vitest.config.ts",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prod:local": "docker compose -f deploy/docker-compose.prod.yml up --build",
    "prod:down": "docker compose -f deploy/docker-compose.prod.yml down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "turbo": "2.11.8",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=11.24.0 <12"
  }
}
