# Plantilla de variables — copiar a .env (nunca commitear .env real)
# API
PORT=3001
DATABASE_URL=postgres://pis:pis_dev@localhost:5432/pis_titulacion
DOCS_VOLUME_PATH=./var/data/titulacion-docs
# Entrega de PDFs: accel (Nginx X-Accel-Redirect, prod) | stream (sin Nginx, dev).
# Vacío = accel si NODE_ENV=production, si no stream.
DOCS_ENTREGA=
# Auth real (A2): HS256 de al menos 32 caracteres (obligatorio en prod)
JWT_SECRET=dev-secret-solo-desarrollo-no-usar-en-prod-123456
# Clave de los usuarios del seed demo (SOLO dev; nunca en prod)
DEMO_PASSWORD=x
# Google OIDC (opcional en dev; sin esto /api/auth/google responde 501)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stub x-user-dni (SOLO dev/curl; 0 = exige Bearer JWT)
AUTH_STUB=0
# Análisis documental experimental local: iniciar el supervisor antes de habilitar.
ANALISIS_DOCUMENTAL_ENABLED=0
# Desarrollo directo solo para fixtures; producción exige docker-queue.
PDF_EXTRACTOR_MODE=docker-queue
PDF_SANDBOX_QUEUE=../docker-volumes/grupo10-proyecto/sandbox/queue
GEMINI_API_KEY=
GEMINI_REVISION_ENABLED=0
GEMINI_MODEL=gemini-2.5-flash
# URL pública de la web: enlaces de los correos (activación, Mi Trámite)
APP_URL=http://localhost:5173
# Web (Vite — prefijo VITE_). VACÍO = mismo origen vía el proxy /api de Vite
# (necesario para la cookie de sesión). Solo poner una URL si la API vive
# en otro origen con CORS + credenciales configurados.
VITE_API_URL=
# Postgres (docker-compose dev)
POSTGRES_USER=pis
POSTGRES_PASSWORD=pis_dev
POSTGRES_DB=pis_titulacion
# Persistencia Docker: ruta absoluta compartida por ambos archivos Compose.
# Si se deja sin definir, se usa ../docker-volumes/grupo10-proyecto junto al repo.
# DOCKER_VOLUMES_PATH=E:/proyectos-general/docker-volumes/grupo10-proyecto
# PROD_PORT=80
# PROD_APP_URL=http://localhost:80
# Correo (dev: Mailpit en http://localhost:8025). Sin SMTP_HOST los correos
# solo se registran en el log. En prod: relay institucional + SMTP_USER/PASS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=no-reply@fips.unsa.edu.pe
